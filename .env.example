# =============================================================================
# AI Internship Screener - environment variables
#
# Copy to .env and fill in:   .\scripts\init-env.ps1   (generates the secrets)
# NEVER commit .env. This file holds placeholders only.
# Sections marked (Phase N) can stay empty until that phase.
# =============================================================================

# ---- General -----------------------------------------------------------------
# dev | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TZ=Asia/Karachi

# ---- Postgres ----------------------------------------------------------------
# Superuser (used only by the postgres container for setup/backups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# n8n's own database + user (created on first start by postgres/init/)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me
# Screener API database + user (LangGraph checkpoints + audit log)
SCREENER_DB_NAME=screener
SCREENER_DB_USER=screener
SCREENER_DB_PASSWORD=change-me

# ---- n8n ---------------------------------------------------------------------
N8N_VERSION=2.42.6
# Encrypts credentials stored in n8n. Generate once and NEVER change it.
N8N_ENCRYPTION_KEY=change-me
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL that Meta/Vapi call. Locally: your tunnel URL (Phase 5). Prod: https://your-domain/
N8N_WEBHOOK_URL=http://localhost:5678/

# ---- Screener API --------------------------------------------------------------
# Shared secret n8n sends in the X-API-Key header (min 16 chars)
SCREENER_API_KEY=change-me-to-a-long-random-string
# Public URL candidates open for interviews (tunnel URL locally, domain in prod)
PUBLIC_BASE_URL=http://localhost:8000

# ---- LLM (Phase 2) -------------------------------------------------------------
# gemini | anthropic | openai
LLM_PROVIDER=gemini
# empty = provider default
LLM_MODEL=
# https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- LangSmith tracing (optional) ----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-internship-screener

# ---- Vapi (Phase 3) ------------------------------------------------------------
# public key, used in the browser page
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# sent by Vapi in the X-Vapi-Secret header
VAPI_WEBHOOK_SECRET=

# ---- Google Calendar (Phase 4) -------------------------------------------------
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=/run/secrets/google-credentials.json
HR_EMAIL=

# ---- Meta WhatsApp Cloud API (Phase 5) -----------------------------------------
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
# used to verify X-Hub-Signature-256 on webhooks
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# E.164 without +, e.g. 923001234567
HR_WHATSAPP_NUMBER=

# ---- Production (Phase 6) ------------------------------------------------------
DOMAIN=screener.example.duckdns.org
ACME_EMAIL=you@example.com
SCREENER_API_IMAGE=ai-screener/screener-api:local

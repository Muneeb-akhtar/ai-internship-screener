    {
      "id": "6c8984cf-c32d-46b0-81be-77eed710eb36",
      "name": "Link status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SCREENER_API_URL }}/candidates/{{ encodeURIComponent($json.candidate_id) }}/interview-status",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SCREENER_API_KEY }}"

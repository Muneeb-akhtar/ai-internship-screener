      "name": "Link status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SCREENER_API_URL }}/candidates/{{ encodeURIComponent($json.candidate_id) }}/interview-status",
        "options": {
          "timeout": 30000,
          "response": {

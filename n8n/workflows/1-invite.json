    {
      "id": "f2cfad78-877c-453f-9920-5287e9be2be6",
      "name": "Create interview link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCREENER_API_URL }}/interview-links",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SCREENER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ candidate_id: String($json.candidate_id), candidate_name: $json.name, role: $json.role }) }}"

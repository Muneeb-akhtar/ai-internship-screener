# Production reverse proxy with automatic HTTPS (Let's Encrypt).
# Started by: docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile prod up -d
# {$DOMAIN} and {$ACME_EMAIL} come from .env via docker-compose.yml.
#
# Same rule as the dev router (Caddyfile.dev): ONLY routes that must be reachable from the
# internet are forwarded. n8n's editor, /evaluate, /review and /docs are never exposed.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Candidate interview pages, HR recording + decision links, provider webhooks, health
	@api path /interview/* /recordings/* /hr/review/* /whatsapp/webhook /elevenlabs/post-call /health
	handle @api {
		reverse_proxy screener-api:8000
	}

	# The only n8n webhook called from outside (Vapi end-of-call report)
	@n8n path /webhook/vapi-end-of-call
	handle @n8n {
		reverse_proxy n8n:5678
	}

	handle {
		respond "Not found" 404
	}
}

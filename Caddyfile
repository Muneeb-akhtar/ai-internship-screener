# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# Only started with `docker compose --profile prod up -d`. Completed in Phase 6.
#
# {$DOMAIN} and {$ACME_EMAIL} come from environment variables set in docker-compose.yml.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Candidate interview pages + agent API
	handle /interview/* {
		reverse_proxy screener-api:8000
	}
	handle /health {
		reverse_proxy screener-api:8000
	}

	# Everything else -> n8n (editor UI + webhooks)
	handle {
		reverse_proxy n8n:5678
	}
}

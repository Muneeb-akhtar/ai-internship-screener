# =============================================================================
# AI Internship Screener - environment variables
#
# Copy to .env and fill in:   .\scripts\init-env.ps1   (generates the secrets)
# NEVER commit .env. This file holds placeholders only.
# Sections marked (Phase N) can stay empty until that phase.
# =============================================================================

# ---- General -----------------------------------------------------------------
# dev | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TZ=Asia/Karachi

# ---- Postgres ----------------------------------------------------------------
# Superuser (used only by the postgres container for setup/backups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# n8n's own database + user (created on first start by postgres/init/)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me
# Screener API database + user (LangGraph checkpoints + audit log)
SCREENER_DB_NAME=screener
SCREENER_DB_USER=screener
SCREENER_DB_PASSWORD=change-me

# ---- n8n ---------------------------------------------------------------------
N8N_VERSION=2.42.6
# Encrypts credentials stored in n8n. Generate once and NEVER change it.
N8N_ENCRYPTION_KEY=change-me
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL that Meta/Vapi call. Locally: your tunnel URL (Phase 5). Prod: https://your-domain/
N8N_WEBHOOK_URL=http://localhost:5678/

# ---- Screener API --------------------------------------------------------------
# Shared secret n8n sends in the X-API-Key header (min 16 chars)
SCREENER_API_KEY=change-me-to-a-long-random-string
# Public URL candidates open for interviews (tunnel URL locally, domain in prod)
PUBLIC_BASE_URL=http://localhost:8000

# ---- LLM (Phase 2) -------------------------------------------------------------
# gemini | anthropic | openai
LLM_PROVIDER=gemini
# empty = provider default (gemini: gemini-3.8-flash)
LLM_MODEL=
# tried automatically if the main model keeps failing, e.g. "503 overloaded"
# empty = provider default (gemini: gemini-3.5-flash)
LLM_FALLBACK_MODEL=
# https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- LangSmith tracing (optional) ----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-internship-screener

# ---- Vapi (Phase 3) ------------------------------------------------------------
# PUBLIC key: shown in the candidate's browser. Restrict it in Vapi (allowed origins + assistant).
VAPI_PUBLIC_KEY=
# PRIVATE key: only used by scripts/vapi.py on your PC. Never put it in the browser or git.
VAPI_PRIVATE_KEY=
# filled automatically by `scripts/vapi.py sync`
VAPI_ASSISTANT_ID=
# sent by Vapi in the X-Vapi-Secret header to the n8n webhook
VAPI_WEBHOOK_SECRET=

# ---- Internship facts the voice assistant may share ------------------------------
COMPANY_NAME=Our Company
INTERNSHIP_DURATION=three months
INTERNSHIP_SCHEDULE=full-time, Monday to Friday
INTERNSHIP_START=next month
# Answers to common candidate questions (one line). Empty = built-in default.
INTERNSHIP_FAQ=

# ---- Google Calendar (Phase 4) -------------------------------------------------
# OAuth for HR's own Google account: run scripts/google_auth.py once, which writes
# secrets/google-token.json (mounted read-only into the API container).
# "primary" = the main calendar of the account you approve with.
GOOGLE_CALENDAR_ID=primary
# Add the candidate as an event attendee (Google emails them the invite)
CALENDAR_INVITE_CANDIDATE=true
HR_EMAIL=

# ---- Meta WhatsApp Cloud API (Phase 5) -----------------------------------------
# From developers.facebook.com -> your app -> WhatsApp -> API Setup
META_APP_ID=
META_WA_PHONE_NUMBER_ID=
META_WABA_ID=
# Access token (temporary 24 h token for first tests; then a System User token)
META_WA_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
# App settings -> Basic -> App secret: verifies X-Hub-Signature-256 on webhooks
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WA_TEMPLATE_LANG=en
# E.164 without +, e.g. 923001234567 (only this number can APPROVE/REJECT)
HR_WHATSAPP_NUMBER=

# ---- n8n workflows (Phase 5) ----------------------------------------------------
# n8n -> Settings -> n8n API -> Create an API key (used by scripts/n8n_workflows.py)
N8N_API_KEY=
# The id in the Google Sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# ---- Production (Phase 6) ------------------------------------------------------
DOMAIN=screener.example.duckdns.org
ACME_EMAIL=you@example.com
SCREENER_API_IMAGE=ai-screener/screener-api:local
